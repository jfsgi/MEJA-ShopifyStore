<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="canonical" href="{{ canonical_url }}">
  <title>{{ page_title }}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}</title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  {{ content_for_header }}
  {{ 'scandi.css' | asset_url | stylesheet_tag }}
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  <style>:root{ --brand: {{ settings.color_brand }}; --accent: {{ settings.color_accent }}; --ink: {{ settings.color_ink }}; }</style>
</head>
<body class="template-{{ request.page_type }}">
  {% section 'header' %}
  <main id="main" role="main">{{ content_for_layout }}</main>
  {% section 'footer' %}
</body>
</html>
