<div class="cd-overlay" id="cart-drawer" hidden data-free-threshold="{{ settings.free_shipping_threshold | default: 0 }}">
  <div class="cd-scrim" data-cd-close></div>
  <aside class="cd-panel" role="dialog" aria-modal="true" aria-label="Your cart">
    <header class="cd-head">
      <h2>Your cart</h2>
      <button class="cd-x" type="button" data-cd-close aria-label="Close cart">✕</button>
    </header>
    <div class="cd-body" id="cd-body" aria-live="polite">
      <div class="cd-empty"><p class="muted">Loading…</p></div>
    </div>
  </aside>
</div>
