<div class="wrap" style="max-width:420px;padding:44px 0">
  <h1 style="font-size:28px;margin-bottom:16px">Create account</h1>
  {%- form 'create_customer' -%}
    {{ form.errors | default_errors }}
    <div class="field"><label>First name</label><input type="text" name="customer[first_name]"></div>
    <div class="field"><label>Last name</label><input type="text" name="customer[last_name]"></div>
    <div class="field"><label>Email</label><input type="email" name="customer[email]"></div>
    <div class="field"><label>Password</label><input type="password" name="customer[password]"></div>
    <button class="btn block" type="submit">Create account</button>
  {%- endform -%}
</div>
{% schema %}{ "name": "Register", "settings": [] }{% endschema %}
