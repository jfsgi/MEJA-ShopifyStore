<footer class="site">
  {%- if section.settings.show_newsletter -%}
  <div class="fnews">
    <div class="wrap fnews-in">
      <div>
        <h3>{{ section.settings.newsletter_heading }}</h3>
        <p>{{ section.settings.newsletter_blurb }}</p>
      </div>
      {%- form 'customer' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div>
          <div class="fnews-form">
            <label class="sr-only" for="news-email">Email address</label>
            <input id="news-email" type="email" name="contact[email]" placeholder="you@example.com" autocomplete="email" required>
            <button class="btn" type="submit">Subscribe</button>
          </div>
          {%- if form.posted_successfully? -%}<p class="fnews-ok">Thanks — you’re on the list.</p>{%- endif -%}
          {{ form.errors | default_errors }}
        </div>
      {%- endform -%}
    </div>
  </div>
  {%- endif -%}

  <div class="wrap">
    <div class="fcols">
      <div><div class="logo">{{ shop.name | default: 'MEJA' }}</div><p style="font-size:13.5px;max-width:32ch;margin-top:10px">{{ section.settings.blurb }}</p></div>
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}><h4>{{ block.settings.title }}</h4><ul>{{ block.settings.links }}</ul></div>
      {%- else -%}
        <div><h4>Shop</h4><ul>
          <li><a href="/collections/all">All products</a></li>
          <li><a href="/collections/drawer-boxes">Drawer Boxes</a></li>
          <li><a href="/collections/cabinet-doors">Cabinet Doors</a></li>
          <li><a href="/collections/shelves">Shelves</a></li>
        </ul></div>
        <div><h4>Help</h4><ul>
          <li><a href="/pages/contact">Contact</a></li>
          <li><a href="/policies/refund-policy">Made-to-order policy</a></li>
          <li><a href="/pages/faq">FAQ</a></li>
        </ul></div>
        <div><h4>Account</h4><ul>
          <li><a href="{{ routes.account_url }}">Sign in</a></li>
          <li><a href="{{ routes.account_url }}">My orders</a></li>
          <li><a href="{{ routes.search_url }}">Search</a></li>
        </ul></div>
      {%- endfor -%}
    </div>
    <div class="legal">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }} — made to order, no returns.</span>
      <span class="fsocial">
        {%- if section.settings.instagram_url != blank -%}
          <a href="{{ section.settings.instagram_url }}" aria-label="Instagram" rel="noopener" target="_blank"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg></a>
        {%- endif -%}
        {%- if section.settings.facebook_url != blank -%}
          <a href="{{ section.settings.facebook_url }}" aria-label="Facebook" rel="noopener" target="_blank"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14 9h2.5V6H14c-2 0-3.5 1.5-3.5 3.5V11H8v3h2.5v7h3v-7H16l.5-3h-3V9.6c0-.4.3-.6.6-.6Z"/></svg></a>
        {%- endif -%}
        {%- if section.settings.pinterest_url != blank -%}
          <a href="{{ section.settings.pinterest_url }}" aria-label="Pinterest" rel="noopener" target="_blank"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 3a9 9 0 0 0-3.3 17.4c-.1-.7-.1-1.8 0-2.6l1-4.4s-.3-.5-.3-1.3c0-1.2.7-2.1 1.6-2.1.8 0 1.1.6 1.1 1.3 0 .8-.5 2-.8 3.1-.2.9.5 1.6 1.4 1.6 1.6 0 2.8-1.7 2.8-4.2 0-2.2-1.6-3.7-3.8-3.7a4 4 0 0 0-4.2 4c0 .8.3 1.6.7 2.1l-.3 1.1c0 .2-.2.2-.3.1-1.1-.5-1.7-2-1.7-3.3 0-2.7 2-5.2 5.7-5.2 3 0 5.3 2.1 5.3 5 0 3-1.8 5.3-4.4 5.3-.9 0-1.7-.5-2-1l-.5 2c-.2.8-.7 1.7-1 2.3A9 9 0 1 0 12 3Z"/></svg></a>
        {%- endif -%}
        <span>Privacy · Terms</span>
      </span>
    </div>
  </div>
</footer>
{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "textarea",
      "id": "blurb",
      "label": "Blurb",
      "default": "Custom drawer boxes, doors, units & shelves — made to order."
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show email signup",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Heading",
      "default": "Join the workshop list"
    },
    {
      "type": "text",
      "id": "newsletter_blurb",
      "label": "Subtext",
      "default": "New finishes, lead-time updates, and made-to-order tips. No spam."
    },
    {
      "type": "header",
      "content": "Social"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "pinterest_url",
      "label": "Pinterest URL"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "links",
          "label": "Links"
        }
      ]
    }
  ]
}
{% endschema %}
