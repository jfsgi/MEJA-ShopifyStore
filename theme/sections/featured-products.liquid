{%- assign coll = section.settings.collection -%}
{%- if coll != blank and coll.products.size > 0 -%}
  <section class="block">
    <div class="wrap">
      <div class="head">
        <div>
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
          <h2>{{ section.settings.heading }}</h2>
        </div>
        <a class="btn ghost" href="{{ coll.url }}">View all →</a>
      </div>
      <div class="cats">
        {%- for product in coll.products limit: section.settings.count -%}
          {% render 'product-card', card_product: product %}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- elsif request.design_mode -%}
  <section class="block">
    <div class="wrap">
      <div class="head"><div><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2></div></div>
      <p class="muted">Pick a collection with products in the theme editor to feature them here. (This message only shows in the editor.)</p>
    </div>
  </section>
{%- endif -%}
{% schema %}
{
  "name": "Featured products",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Ready to ship"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Popular pieces"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "count",
      "min": 3,
      "max": 8,
      "step": 1,
      "label": "Products to show",
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Featured products"
    }
  ]
}
{% endschema %}
