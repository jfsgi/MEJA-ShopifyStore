<div class="wrap" style="padding:30px 0 56px">
  <h1 style="font-size:28px">Order {{ order.name }}</h1>
  <p class="muted">Placed {{ order.created_at | date: '%b %-d, %Y' }} &middot; {{ order.financial_status_label }} &middot; {{ order.fulfillment_status_label }}</p>
  <div style="margin-top:18px">
    {%- for line in order.line_items -%}
      <div class="line">
        <div class="thumb" {% if line.image %}style="background-image:url({{ line.image | image_url: width: 240 }})"{% endif %}></div>
        <div>
          <h3>{{ line.title }}</h3>
          <div class="chips">{%- for p in line.properties -%}{%- assign fc = p.first | slice: 0 -%}{%- if p.last != blank and fc != '_' -%}<span>{{ p.first }}: {{ p.last }}</span>{%- endif -%}{%- endfor -%}</div>
          <div class="muted" style="font-size:12.5px;margin-top:4px">Qty {{ line.quantity }}</div>
        </div>
        <div class="lineprice">{{ line.final_line_price | money }}</div>
      </div>
    {%- endfor -%}
  </div>

  <div class="summary" style="position:static;max-width:320px;margin:22px 0 0">
    <div class="srow"><span>Subtotal</span><span class="mono">{{ order.line_items_subtotal_price | money }}</span></div>
    {%- if order.shipping_price > 0 -%}<div class="srow"><span>Shipping</span><span class="mono">{{ order.shipping_price | money }}</span></div>{%- endif -%}
    {%- if order.tax_price > 0 -%}<div class="srow"><span>Tax</span><span class="mono">{{ order.tax_price | money }}</span></div>{%- endif -%}
    <div class="srow" style="border-top:1px solid var(--line);margin-top:6px;padding-top:12px"><span><b>Total</b></span><span class="mono"><b>{{ order.total_price | money }}</b></span></div>
  </div>

  {%- if order.shipping_address -%}
    <div class="info" style="margin-top:20px;max-width:360px"><b>Shipping to</b><br>{{ order.shipping_address | format_address }}</div>
  {%- endif -%}
</div>
{% schema %}
{
  "name": "Order",
  "settings": [

  ]
}
{% endschema %}
