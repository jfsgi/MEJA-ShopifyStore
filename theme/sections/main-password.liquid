<div class="wrap" style="max-width:460px;padding:64px 0;text-align:center">
  <h1 style="font-size:30px;margin-bottom:10px">{{ section.settings.heading | default: shop.name }}</h1>
  {%- if section.settings.message != blank -%}
    <div class="rte muted" style="font-size:15px;margin-bottom:22px">{{ section.settings.message }}</div>
  {%- else -%}
    <p class="muted" style="font-size:15px;margin-bottom:22px">Opening soon. Enter the store password to continue.</p>
  {%- endif -%}

  {%- form 'storefront_password' -%}
    {{ form.errors | default_errors }}
    <div class="field" style="text-align:left">
      <label for="store-password">Password</label>
      <input id="store-password" type="password" name="password" autocomplete="current-password" required>
    </div>
    <button class="btn block" type="submit">Enter</button>
  {%- endform -%}

  <p class="muted" style="margin-top:20px;font-size:12.5px">Are you the store owner? <a href="/admin" style="color:var(--brand);font-weight:600">Log in here</a>.</p>
</div>
{% schema %}
{
  "name": "Password",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Defaults to the shop name."
    },
    {
      "type": "richtext",
      "id": "message",
      "label": "Message"
    }
  ]
}
{% endschema %}
