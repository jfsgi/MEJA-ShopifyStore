<div class="wrap" style="max-width:420px;padding:44px 0">
  <h1 style="font-size:28px;margin-bottom:16px">Reset password</h1>
  {%- form 'reset_customer_password' -%}
    {{ form.errors | default_errors }}
    <div class="field"><label>New password</label><input type="password" name="customer[password]"></div>
    <div class="field"><label>Confirm password</label><input type="password" name="customer[password_confirmation]"></div>
    <button class="btn block" type="submit">Reset password</button>
  {%- endform -%}
</div>
{% schema %}{ "name": "Reset password", "settings": [] }{% endschema %}
