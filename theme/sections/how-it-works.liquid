<section class="block hiw">
  <div class="wrap">
    <div class="head">
      <div>
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        <h2>{{ section.settings.heading }}</h2>
      </div>
    </div>
    <div class="steps">
      {%- for block in section.blocks -%}
        <div class="step" {{ block.shopify_attributes }}>
          <div class="num">{{ forloop.index }}</div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "How it works",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Made to order"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How it works"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Step"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Describe this step."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "How it works",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Configure",
            "text": "Choose size, wood, joinery and finish in the live configurator."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "See it in 4K",
            "text": "Approve a photoreal 4K render of your exact piece before we build."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Hand-built",
            "text": "We build it in solid hardwood to your specs — no mass production."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Delivered",
            "text": "Carefully packed and shipped to your door, typically in 1–3 weeks."
          }
        }
      ]
    }
  ]
}
{% endschema %}
