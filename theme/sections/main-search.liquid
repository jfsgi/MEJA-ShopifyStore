<div class="wrap" style="padding:24px 0 56px">
  <h1 style="font-size:30px">Search</h1>
  <form action="{{ routes.search_url }}" method="get" role="search" style="margin:16px 0">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search drawer boxes, doors, shelves..." style="padding:12px 16px;border:1.5px solid var(--line);border-radius:999px;width:min(440px,100%)">
  </form>
  {%- if search.performed -%}
    <p class="muted">{{ search.results_count }} results for &ldquo;{{ search.terms }}&rdquo;</p>
    <div class="grid">
      {%- for item in search.results -%}
        {%- if item.object_type == 'product' -%}{% render 'product-card', card_product: item %}{%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>
{% schema %}{ "name": "Search", "settings": [] }{% endschema %}
