<div class="wrap">
  <div class="pdp">
    <div class="gallery">
      <div class="main" id="pdp-main" style="background-image:url({% if product.featured_image %}{{ product.featured_image | image_url: width: 1200 }}{% else %}{{ 'pdp-default.jpg' | asset_url }}{% endif %})"></div>
      {%- if product.images.size > 1 -%}
        <div class="thumbs">
          {%- for image in product.images limit: 6 -%}
            <button type="button" class="thumb{% if image == product.featured_image %} on{% endif %}" data-full="{{ image | image_url: width: 1200 }}" style="background-image:url({{ image | image_url: width: 200 }})" aria-label="View image {{ forloop.index }} of {{ product.images.size }}"></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
    <div class="details">
      <span class="eyebrow">{{ product.type }}</span>
      <h1>{{ product.title }}</h1>
      <a class="ratelink" href="#reviews"><span class="stars">★★★★★</span> {{ product.metafields.reviews.rating | default: '4.9' }}</a>
      {%- form 'product', product, class: 'product-form' -%}
        {%- assign pdp_variant = product.selected_or_first_available_variant | default: product.variants.first -%}
        <input type="hidden" name="id" value="{{ pdp_variant.id }}">
        <div class="price">{{ product.price | money }} <small>+ size · made to order</small></div>
        <div class="custom-note">📐 Sold made-to-size. <a href="{{ pages['configurator'].url | default: '#' }}">Enter your dimensions in the configurator →</a></div>
        {% render 'price-block' %}
      {%- endform -%}
      <div class="rte">{{ product.description }}</div>
    </div>
  </div>
</div>

<div class="wrap" id="reviews">
  {%- comment -%} Reviews app widget (Judge.me / Loox / Okendo) injects here as an app block. {%- endcomment -%}
  {%- for block in section.blocks -%}
    {%- if block.type == '@app' -%}{% render block %}{%- endif -%}
  {%- endfor -%}
</div>

<div class="stickybar" id="pdp-sticky">
  <div class="sb-info">
    <span class="sb-title">{{ product.title }}</span>
    <span class="sb-price">{{ product.price | money }}</span>
  </div>
  <button type="button" class="btn" id="sb-add">{{ 'products.product.add_to_cart' | t }}</button>
</div>

<script>
  (function () {
    var gallery = document.querySelector('.gallery');
    if (gallery) {
      var main = gallery.querySelector('#pdp-main');
      var thumbs = gallery.querySelectorAll('.thumb');
      thumbs.forEach(function (t) {
        t.addEventListener('click', function () {
          if (t.dataset.full) main.style.backgroundImage = "url(" + t.dataset.full + ")";
          thumbs.forEach(function (x) { x.classList.remove('on'); });
          t.classList.add('on');
        });
      });
    }

    // Mobile sticky add-to-cart: show when the in-form Add button is off-screen.
    var sticky = document.getElementById('pdp-sticky');
    var addBtn = document.getElementById('meja-add');
    var sbAdd = document.getElementById('sb-add');
    if (sticky && addBtn && 'IntersectionObserver' in window) {
      new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { sticky.classList.toggle('show', !e.isIntersecting); });
      }, { rootMargin: '0px 0px -40% 0px' }).observe(addBtn);
    }
    if (sbAdd && addBtn) sbAdd.addEventListener('click', function () { addBtn.click(); });
  })();
</script>
{% schema %}
{
  "name": "Product",
  "settings": [

  ],
  "blocks": [
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
