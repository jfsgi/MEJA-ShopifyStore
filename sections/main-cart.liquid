<div class="wrap">
  <h1 class="carttitle">{{ 'cart.general.title' | t }}</h1>
  {% form 'cart', cart %}
  <div class="cartwrap">
    <div class="lines">
      {%- for item in cart.items -%}
      <div class="line">
        <div class="thumb" {% if item.image %}style="background-image:url({{ item.image | image_url: width: 240 }})"{% endif %}><span class="k">4K render</span></div>
        <div>
          <h3>{{ item.product.title }}</h3>
          <div class="chips">{%- for p in item.properties -%}{%- unless p.last == blank -%}<span>{{ p.last }}</span>{%- endunless -%}{%- endfor -%}</div>
        </div>
        <div class="lineprice">{{ item.final_line_price | money }}</div>
      </div>
      {%- endfor -%}
    </div>
    <aside class="summary">
      <h3>Order summary</h3>
      <div class="srow"><span>Subtotal</span><span class="mono">{{ cart.total_price | money }}</span></div>
      <div class="srow"><span>Made-to-order lead time</span><span>1–3 weeks</span></div>
      <button class="btn block checkout" type="submit" name="checkout">{{ 'cart.general.checkout' | t }} →</button>
      <div class="trustline">🔒 Secure checkout by Shopify.</div>
      <div class="trustline">🛈 Every piece is made to order — <b>no returns or exchanges</b>.</div>
    </aside>
  </div>
  {% endform %}
</div>
{% schema %}
{
  "name": "Cart",
  "settings": [

  ]
}
{% endschema %}
