<div class="wrap">
  <h1 class="carttitle">{{ 'cart.general.title' | t }}</h1>

  {%- if cart.item_count == 0 -%}
    <div class="empty" style="margin:30px auto 64px">
      <h3 style="font-size:20px;margin-bottom:6px">Your cart is empty</h3>
      <p class="muted" style="font-size:14px;margin-bottom:16px">Configure a made-to-order piece to get started.</p>
      <a class="btn" href="{{ routes.all_products_collection_url }}">Browse products</a>
    </div>
  {%- else -%}
  {%- form 'cart', cart -%}
  <div class="cartwrap">
    <div class="lines">
      {%- for item in cart.items -%}
      <div class="line">
        <div class="thumb" {% if item.image %}style="background-image:url({{ item.image | image_url: width: 240 }})"{% endif %}>{%- if item.properties['_configId'] != blank or item.properties['_meja_unit_price'] != blank -%}<span class="k">4K render</span>{%- endif -%}</div>
        <div>
          <h3><a href="{{ item.url }}">{{ item.product.title }}</a></h3>
          {%- unless item.variant.title contains 'Default' -%}<div class="vtitle muted">{{ item.variant.title }}</div>{%- endunless -%}
          <div class="chips">
            {%- for p in item.properties -%}
              {%- assign first_char = p.first | slice: 0 -%}
              {%- if p.last != blank and first_char != '_' -%}<span>{{ p.first }}: {{ p.last }}</span>{%- endif -%}
            {%- endfor -%}
          </div>
          <div class="linectl">
            <label class="sr-only" for="qty-{{ forloop.index }}">Quantity</label>
            <input id="qty-{{ forloop.index }}" class="qtyin" type="number" inputmode="numeric" min="0" name="updates[]" value="{{ item.quantity }}" aria-label="Quantity for {{ item.product.title | escape }}">
            <a class="remove" href="{{ item.url_to_remove }}">Remove</a>
          </div>
        </div>
        <div class="lineprice">
          {{ item.final_line_price | money }}
          {%- if item.quantity > 1 -%}<div class="each muted">{{ item.final_price | money }} each</div>{%- endif -%}
        </div>
      </div>
      {%- endfor -%}
      <div class="cartactions">
        <a class="btn ghost" href="{{ routes.all_products_collection_url }}">Continue shopping</a>
        <button class="btn ghost" type="submit" name="update">Update cart</button>
      </div>
    </div>

    <aside class="summary">
      <h3>Order summary</h3>
      <div class="srow"><span>Subtotal</span><span class="mono">{{ cart.total_price | money }}</span></div>
      {%- if cart.total_discount > 0 -%}<div class="srow"><span>Discount</span><span class="mono">&minus;{{ cart.total_discount | money }}</span></div>{%- endif -%}
      <div class="srow"><span>Shipping</span><span class="muted">Calculated at checkout</span></div>
      <div class="srow"><span>Made-to-order lead time</span><span>1–3 weeks</span></div>
      <div class="field" style="margin:14px 0 8px">
        <label for="cart-note">Order notes (optional)</label>
        <textarea id="cart-note" name="note" rows="2" placeholder="Delivery instructions, project details…">{{ cart.note }}</textarea>
      </div>
      <button class="btn block checkout" type="submit" name="checkout">{{ 'cart.general.checkout' | t }} →</button>
      <div class="trustline">🔒 Secure checkout by Shopify.</div>
      <div class="trustline">🛈 Every piece is made to order — <b>no returns or exchanges</b>.</div>
    </aside>
  </div>
  {%- endform -%}
  {%- endif -%}
</div>
{% schema %}
{
  "name": "Cart",
  "settings": [

  ]
}
{% endschema %}
