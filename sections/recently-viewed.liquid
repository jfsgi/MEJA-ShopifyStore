{%- comment -%}
  Recently viewed products. The current product handle is recorded in localStorage on each
  PDP visit; the loader renders cards for previously viewed products (excluding the current
  one) by fetching /products/{handle}.js. No app or admin data required.
{%- endcomment -%}
<section class="block" data-recently-viewed data-current="{{ product.handle }}" data-limit="{{ section.settings.products_to_show }}" hidden>
  <div class="wrap">
    <div class="head"><div><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2></div></div>
    <div class="cats" data-rv-slot></div>
  </div>
</section>
<script src="{{ 'recently-viewed.js' | asset_url }}" defer></script>
{% schema %}
{
  "name": "Recently viewed",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Pick up where you left off"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Recently viewed"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 10,
      "step": 1,
      "label": "Products to show",
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Recently viewed"
    }
  ]
}
{% endschema %}
