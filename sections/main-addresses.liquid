<div class="wrap" style="padding:30px 0 56px">
  <h1 style="font-size:28px;margin-bottom:14px">Addresses</h1>
  {%- for address in customer.addresses -%}
    <div class="order" style="grid-template-columns:1fr auto"><div class="meta">{{ address | format_address }}</div></div>
  {%- else -%}
